# --- Telegram ---
BOT_TOKEN=ضع_توكن_البوت_من_BotFather
ADMIN_TELEGRAM_ID=123456789
BOT_TITLE=اسم البوت

# --- Ichancy (حساب الوكيل) ---
# انسخ الكوكيز من المتصفح بعد تسجيل الدخول إلى agents.ichancy.com
# اتركه فارغاً لتشغيل وضع تجريبي (Mock) بدون اتصال حقيقي
ICHANCY_COOKIE=
PARENT_ID=
EMAIL_DOMAIN=example.com
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/139.0 Safari/537.36

# --- الداشبورد ---
ADMIN_USER=admin
ADMIN_PASSWORD=غيّر_هذه_الكلمة_إلى_كلمة_قوية
SECRET_KEY=اكتب_نصاً_عشوائياً_طويلاً
ADMIN_CHAT_ID=
PORT=8080
DB_PATH=data.db

# --- اختياري: بذر الإعدادات عند أول تشغيل (مفيد حين يُمسح القرص على الاستضافة المجانية) ---
# SET_SHAM_NUMBER=معرّف_شام_كاش
# SET_SYRIATEL_NUMBER=رقم_سيريتل_كاش
# SET_EXCHANGE_RATE=14000
# SET_SITE_RATE=0
# SET_MIN_DEPOSIT=25
# SET_PARENT_ID=
# الكوكيز و PARENT_ID يمكن إدخالهما أيضاً من الداشبورد ← الإعدادات بدل .env
